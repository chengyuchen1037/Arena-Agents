# =============================================================================
# Arena-Agents Environment Variables
# 复制本文件为 .env 后填写（.env 已被 .gitignore / .dockerignore 排除，切勿提交）。
#
# Provider（API key、base_url、协议、模型清单与价格）不写在 .env，而是在界面“Provider”管理里添加：
# 除 API Key 外的部分是明文的 data/providers.json，Key 单独加密保存在 data/secrets.v1.enc（见 docs/storage.md）。
# 本文件只放部署级设置与访问控制；严禁在这里（或任何仓库内文件）存放真实密钥后提交。
# 下面凡是以“# 变量=”形式注释掉的行，需要时取消注释并填值；不要留下“变量=”的空值（空值会被当成已设置）。
# =============================================================================

# --- 数据目录 ------------------------------------------------------------------
# v0.13：所有数据（Provider 注册表、API Key、设置、名册、对局、思考日志、导出的存档）都在
#   <程序目录>/data/
# 下。“程序目录”是含 app/ 和 config.yml 的文件夹，与启动命令所在的当前目录无关。没有“工作文件夹”可选。
# 删除或重装程序目录、git clean -xdf 会连 data/ 一起删掉：请定期在“设置”里导出存档。
# 演示模式（ARENA_DEMO=1）使用 <程序目录>/.demo-data/demo，不会混进真实的历史对局。
# 想把数据放在别处（测试、开发实例、Docker 以外的自定义卷）时指定：
# ARENA_DATA_DIR=D:\ArenaData
# Docker 下数据目录固定是 /app/data（卷 arena-appdata，见 docker-compose.yml），不需要设置这个变量。
#
# 同一个数据目录同一时间只能有一个服务在用（data/.lock 进程锁）；第二个实例会拒绝启动。

# 导入存档（.arenaagents）的大小上限，字节，默认 2 GiB：
# ARENA_MAX_ARCHIVE_BYTES=2147483648

# --- 主密钥（只用来加密 API Key）---------------------------------------------------
# 只有 API Key 是加密保存的（AES-256-GCM，data/secrets.v1.enc）；其余数据都是明文。
# 主密钥是 32 字节随机数的 base64/base64url：
#   * 原生 Windows：不需要设置。主密钥由 DPAPI（当前 Windows 用户）保护并保存在 data/master.v1.dpapi，自动解锁。
#   * Docker / Linux / macOS：保存 API Key 时必须提供。推荐用 Docker Secret / 密钥文件，而不是环境变量：
#       ARENA_MASTER_KEY_FILE=/run/secrets/arena_master_key     （compose 已自动设置，宿主机路径用
#       ARENA_MASTER_KEY_HOST_FILE 指定，见 docker-compose.yml 顶部）
#     不要把密钥文件放在 data/ 或项目目录里；丢失主密钥 = 已保存的 API Key 无法恢复（其余数据不受影响，重新输入 Key
#     即可），请单独备份。
#     生成示例：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#   * 未提供主密钥时应用 fail closed：不能保存 API Key（可以保存没有 Key 的 Provider），不会明文回退。
# ARENA_MASTER_KEY_FILE=/path/to/master_key
# 备选：直接提供密钥（不推荐，环境变量可能被进程列表/日志泄露）。
# ARENA_MASTER_KEY=

# 仅 docker compose 使用（宿主机侧）：
#   ARENA_MASTER_KEY_HOST_FILE=/srv/arena-secrets/master_key   # 必填：主密钥文件路径（项目目录之外）
#   ARENA_DATA_HOST=/srv/arena-data                            # 可选：宿主机数据目录，默认命名卷 arena-appdata
#   ARENA_BIND=127.0.0.1                                       # 宿主机端口绑定地址，对外开放改为 0.0.0.0

# --- 环境变量 Provider（只读，可不填）----------------------------------------------
# 设置了 DEEPSEEK_API_KEY 时，会出现一个**只读**的“DeepSeek（环境变量）”Provider（界面不可编辑；
# Key 不写入 data/，也不进入导出的存档）。适合 Docker 里不想保存 Key 的部署。
# 新部署请留空，直接在界面“Provider”管理里添加。曾写在明文 .env 里的 key 应视为已暴露，请到服务商处轮换。
# DEEPSEEK_API_KEY=
# 不带 /v1，与 config.yml 的默认值一致
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# --- 服务监听 ------------------------------------------------------------------
# 本机直接运行时的监听地址与端口，例如：
#   uvicorn app.main:app --host %HOST% --port %PORT%      (Windows cmd)
#   uvicorn app.main:app --host "$HOST" --port "$PORT"    (bash)
# 默认只监听本机回环地址。改成 0.0.0.0（对外开放）前，务必先设置下面的 ARENA_API_TOKEN。
# 注意：应用代码本身不读取 HOST；Docker 下容器内固定监听 0.0.0.0:8000，
#   PORT 仅作为 compose 的宿主机端口，ARENA_BIND 决定宿主机绑定地址（默认 127.0.0.1）。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# --- 访问控制（强烈建议在非本机访问时启用）--------------------------------------
# API 令牌：设置后，所有 /api/* 请求必须带请求头 `X-Arena-Token: <token>`
# （EventSource 无法带头，GET /api/events 额外允许 ?token=<token>）。静态页面与 / 不鉴权。
# 留空表示不启用：此时只有本机回环地址的客户端可以调用修改类接口
# （Provider 管理、模型绑定、存档导入等）。经 Docker 端口映射访问时来源不是回环地址，
# 所以容器部署若要使用这些接口，必须设置令牌。生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 这是 Arena 自身的访问令牌，不是 Provider 密钥，不会写入加密 Provider 库。
# ARENA_API_TOKEN=

# 额外允许的跨站来源（逗号分隔，含协议与端口）。非 GET 请求若带 Origin 头，其主机必须等于
# 请求的 Host 头或出现在此列表中，否则返回 403。通过反向代理/自定义域名访问时才需要，例如：
#   ARENA_ALLOWED_ORIGINS=https://arena.example.com
# ARENA_ALLOWED_ORIGINS=

# Provider base_url 主机白名单（逗号分隔，仅主机名）。非空时，新建/编辑 Provider 的 base_url
# 主机必须在名单内；留空表示允许任意公网主机（私网/回环地址另受下面的开关限制）。例如：
#   ARENA_ALLOWED_BASE_HOSTS=api.deepseek.com,api.openai.com,api.anthropic.com
# ARENA_ALLOWED_BASE_HOSTS=

# 是否允许 Provider 的 base_url / “获取模型”访问私网与回环地址（Ollama、LM Studio 等本地模型服务需要）。
# 默认 false；云元数据等链路本地地址（如 169.254.169.254）无论如何都会被阻断。
# 只应由本机管理员在受信任环境中开启。
ARENA_ALLOW_PRIVATE_PROVIDERS=false
